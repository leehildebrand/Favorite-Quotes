<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main class="page-shell">
      <section class="hero-card">
        <div class="hero-topbar">
          <div class="search-form">
            <label for="q" class="sr-only">Search quotes</label>
            <input
              id="q"
              name="q"
              type="text"
              value="<%= searchTerm %>"
              placeholder="Search by quote text or author"
              autocomplete="off"
            />
            <a class="button-link" href="/new<%= searchTerm && searchTerm.trim() ? `?q=${encodeURIComponent(searchTerm.trim())}` : '' %>">New Quote</a>
            <% if (searchTerm && searchTerm.trim()) { %>
              <a class="clear-link" href="/">Clear</a>
            <% } %>
          </div>
        </div>
      </section>

      <section class="quotes-card">
        <% if (searchTerm && searchTerm.trim()) { %>
          <h2>Results for "<%= searchTerm %>"</h2>
        <% } %>

        <% if (!quotes.length) { %>
          <p class="empty-state">No quotes yet. Add your first one above.</p>
        <% } else { %>
          <p class="empty-state" id="no-results" hidden>No quotes match your search.</p>
          <ul class="quote-list">
            <% quotes.forEach((quote) => { %>
              <li class="quote-item" data-search-value="<%= `${quote.quote_text} ${quote.author || ''}`.toLowerCase() %>">
                <blockquote><%= quote.quote_text %></blockquote>
                <p class="meta">
                  <% if (quote.author) { %>
                    <span><%= quote.author %></span>
                  <% } %>
                </p>
                <a class="quote-manage-link" href="/quotes/<%= quote.id %>/edit<%= searchTerm && searchTerm.trim() ? `?q=${encodeURIComponent(searchTerm.trim())}` : '' %>">Manage</a>
              </li>
            <% }); %>
          </ul>
          <div id="quotes-end" aria-hidden="true"></div>
        <% } %>
      </section>
    </main>
    <% if (quotes.length) { %>
      <script>
        (() => {
          const searchInput = document.getElementById('q');
          const items = Array.from(document.querySelectorAll('.quote-item'));
          const noResults = document.getElementById('no-results');

          const filterQuotes = () => {
            const query = searchInput.value.trim().toLowerCase();
            let visibleCount = 0;

            items.forEach((item) => {
              const matches = !query || item.dataset.searchValue.includes(query);
              item.hidden = !matches;
              if (matches) {
                visibleCount += 1;
              }
            });

            noResults.hidden = visibleCount !== 0 || !query;
          };

          searchInput.addEventListener('input', filterQuotes);
          filterQuotes();
        })();
      </script>
    <% } %>
  </body>
</html>

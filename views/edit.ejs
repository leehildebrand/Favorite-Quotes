<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main class="page-shell">
      <section class="hero-card">
        <div class="hero-topbar">
          <h1>Manage Quote</h1>
          <a class="button-link" href="/<%= searchTerm && searchTerm.trim() ? `?q=${encodeURIComponent(searchTerm.trim())}` : '' %>">Back to Quotes</a>
        </div>
      </section>

      <section class="add-card">
        <% if (error) { %>
          <p class="error"><%= error %></p>
        <% } %>

        <form action="/quotes/<%= quote.id %>/edit<%= searchTerm && searchTerm.trim() ? `?q=${encodeURIComponent(searchTerm.trim())}` : '' %>" method="POST" class="quote-form">
          <label for="quoteText">Quote</label>
          <textarea
            id="quoteText"
            name="quoteText"
            rows="4"
            placeholder="Type your favorite quote"
            required
          ><%= form.quoteText %></textarea>

          <label for="author">Author (optional)</label>
          <input
            id="author"
            name="author"
            type="text"
            value="<%= form.author %>"
            placeholder="Who said it?"
          />

          <button type="submit">Save Quote</button>
        </form>

        <form action="/quotes/<%= quote.id %>/delete<%= searchTerm && searchTerm.trim() ? `?q=${encodeURIComponent(searchTerm.trim())}` : '' %>" method="POST" class="delete-form" onsubmit="return confirm('Delete this quote?');">
          <button class="danger-button" type="submit">Delete Quote</button>
        </form>
      </section>
    </main>
  </body>
</html>
